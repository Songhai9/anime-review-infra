# GitLab CI/CD variables for the anime-review-infra project.
# This file is a CHECKLIST, not something the pipeline reads.
# Create each entry in GitLab: Settings → CI/CD → Variables (Protected = yes, branch main protected).
# Never commit real values.

# ---- Phase 3 (root .gitlab-ci.yml) -------------------------------------------------
# Output of: terraform -chdir=bootstrap output -raw terraform_ci_role_arn
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/GitLabAnimeReviewTerraformRole

# Public IP allowed to SSH into the bastion (break-glass only in phase 3)
TF_VAR_admin_cidr=203.0.113.10/32

# One line: contents of ~/.ssh/anime-review.pub (NOT the path)
TF_VAR_ssh_public_key=ssh-ed25519 AAAAREPLACE anime-review

# Already defined in .gitlab-ci.yml — change them there if your names differ:
#   ANSIBLE_SSM_BUCKET=replace-me-anime-review-ansible-ssm-eu-north-1
#   AWS_REGION=eu-north-1
#   REBUILD_CLUSTER=false   (set to true only in "Run pipeline" to force a full rebuild)

# ---- Phase 2b only (legacy/.gitlab-ci.yml) -----------------------------------------
# Type = File. Private key with a trailing newline.
# SSH_PRIVATE_KEY=<file variable>
# Type = File. The Ansible Vault password.
# ANSIBLE_VAULT_PASSWORD_FILE=<file variable>
# IMAGE_TAG is forwarded by the application pipeline: do not define it here.

# ---- Project settings (not variables) ----------------------------------------------
# anime-review-k8s → Settings → CI/CD → Job token permissions → allow this project (bootstrap_k8s trigger)
# Container registry of this project must hold ci-image:1.1 (ci/Dockerfile) before the first pipeline.
