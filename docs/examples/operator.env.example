# Workstation shell file. NOT loaded by Terraform or Ansible automatically.
# Copy outside Git (e.g. ~/.config/anime-review/operator.env), replace values,
# authenticate first (aws login --profile ... / aws sso login --profile ...), then:
#   . ~/.config/anime-review/operator.env
# Contains no credentials or passwords.

export AWS_PROFILE=REPLACE_WITH_AWS_PROFILE
export AWS_DEFAULT_PROFILE="$AWS_PROFILE"
export AWS_REGION=eu-north-1
export AWS_DEFAULT_REGION=eu-north-1
export AWS_ACCOUNT_ID=123456789012

# Transfer bucket (bootstrap output ansible_ssm_bucket_name), NOT the Terraform state bucket.
# Required by ansible/scripts/generate_inventory.sh and by the k8s bootstrap-via-ssm script.
export ANSIBLE_SSM_BUCKET=replace-me-anime-review-ansible-ssm-eu-north-1

# macOS only (uncomment): avoids Ansible worker crashes after fork().
# export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
