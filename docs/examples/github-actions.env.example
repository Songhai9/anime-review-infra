# GitHub Actions settings for anime-review-infra (.github/workflows/infra.yml).
# CHECKLIST ONLY: the workflow does not read this file. Never commit real values.

# Settings → Secrets and variables → Actions → Variables
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/GitLabAnimeReviewTerraformRole   # bootstrap output terraform_ci_role_arn
AWS_REGION=eu-north-1
ANSIBLE_SSM_BUCKET=replace-me-anime-review-ansible-ssm-eu-north-1
TF_VAR_ADMIN_CIDR=203.0.113.10/32
TF_VAR_SSH_PUBLIC_KEY=ssh-ed25519 AAAAREPLACE anime-review

# Settings → Secrets and variables → Actions → Secrets
# Fine-grained PAT, repository access: anime-review-k8s only, "Actions: Read and write"
K8S_WORKFLOW_TOKEN=github_pat_REPLACE_ME

# Settings → Environments → New environment "infrastructure"
#   → Required reviewers: yourself. This is the approval step before `terraform apply`.
#   The IAM role trusts repo:<owner>/anime-review-infra:environment:infrastructure (bootstrap/main.tf).

# AWS side (done by `terraform -chdir=bootstrap apply`):
#   OIDC provider token.actions.githubusercontent.com + trust statement "GitHubActions" on the CI role.
#   If you fork, change "Songhai9/anime-review-infra" in bootstrap/main.tf.
